          "queries": [
            {
              "query": "SELECT q._timestamp, q.duration / 1000.0 as duration_ms, r.uri as endpoint, q.jdbc_query_0_ as statement, q.jdbc_datasource_name as datasource, q.trace_id as trace_id FROM \"__STREAM__\" as q JOIN \"__STREAM__\" as r ON q.trace_id = r.trace_id WHERE q.operation_name = 'query' AND r.span_kind = 2 ORDER BY duration_ms DESC LIMIT 100",
              "customQuery": true,
              "fields": {
                "stream": "__STREAM__",
                "stream_type": "traces",
                "x": [
