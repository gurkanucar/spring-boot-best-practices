# Copy to .env (git-ignored) and fill in from the Logto console.
# Applications -> your app:
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=
# Webhooks -> your webhook -> Signing key (optional: without it every webhook is rejected):
LOGTO_WEBHOOK_SIGNING_KEY=
# Applications -> a Machine-to-machine app with the "Logto Management API access" role.
# Only docker/logto/setup.sh uses these (the Spring Boot app does not):
LOGTO_M2M_CLIENT_ID=
LOGTO_M2M_CLIENT_SECRET=
